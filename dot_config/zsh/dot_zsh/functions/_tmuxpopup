function _tmuxpopup() {
  local initial_cmd="${1:-}"
  local title="${2:-}"

  local width='80%'
  local height='80%'

  local session
  session="$(tmux display-message -p -F '#{session_name}' 2>/dev/null)" || return 1

  local window_index
  window_index="$(tmux display-message -p -F '#{window_index}')" || return 1

  local window_name
  window_name="$(tmux display-message -p -F '#{window_name}')" || return 1

  local pane_path
  pane_path="$(tmux display-message -p -F '#{pane_current_path}')" || return 1

  local key=""

  if git -C "$pane_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local common_dir
    common_dir=$(git -C "$pane_path" rev-parse --git-common-dir)
    local repo_name
    if [[ "$common_dir" == ".git" ]]; then
      # 通常git: repo名のみ
      repo_name=$(basename "$(git -C "$pane_path" rev-parse --show-toplevel)")
      key="${repo_name}"
    else
      # worktree: repo名 + branch名
      repo_name=$(basename "$(dirname "$common_dir")")
      local branch_name
      branch_name=$(git -C "$pane_path" symbolic-ref --short HEAD 2>/dev/null || git -C "$pane_path" rev-parse --short HEAD)
      key="${repo_name}/${branch_name}"
    fi
  else
    # 非git: ディレクトリ名
    key="${pane_path:t}"
  fi

  local popup_session="p@${key}"

  if [[ "$session" == p@* ]]; then
    tmux detach-client
    return 0
  fi

  local exec_cmd
  if tmux has-session -t "${popup_session}" 2>/dev/null; then
    # Session exists, just attach
    exec_cmd="tmux attach -t ${popup_session}"
  else
    # New session: save origin session info as environment variables
    if [[ -n "$initial_cmd" ]]; then
      exec_cmd="tmux new -s ${popup_session} -e POPUP_ORIGIN_SESSION=${session} -e POPUP_ORIGIN_WINDOW=${window_index} '${initial_cmd}'"
    else
      exec_cmd="tmux new -s ${popup_session} -e POPUP_ORIGIN_SESSION=${session} -e POPUP_ORIGIN_WINDOW=${window_index}"
    fi
  fi

  local display_title="${title} @ ${key}"

  tmux display-popup \
    -d "#{pane_current_path}" \
    -xC -yC \
    -w "$width" -h "$height" \
    -T "$display_title" \
    -E "$exec_cmd"
}
